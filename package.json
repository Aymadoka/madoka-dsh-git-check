{
  "name": "madoka-dsh-git-check",
  "version": "0.1.0",
  "description": "DSH 插件 — 一键扫描、分类、审查并提交代码",
  "license": "MIT",
  "homepage": "https://github.com/Aymadoka/madoka-dsh-git-check#readme",
  "bugs": {
    "url": "https://github.com/Aymadoka/madoka-dsh-git-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aymadoka/madoka-dsh-git-check.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "tsc -p tsconfig.tests.json && node .test-out/tests/scanner.test.js && node .test-out/tests/checks.test.js && node .test-out/tests/stage-commit.test.js && node .test-out/tests/ignore.test.js",
    "check": "npm run build && npm run typecheck && npm run test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-desktop",
    "plugin",
    "git",
    "commit",
    "gitignore"
  ]
}
